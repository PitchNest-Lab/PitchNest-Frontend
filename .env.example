# ── Frontend Environment Variables ──
# Set these in the Vercel project settings (Environment Variables).
#
# Two environments, two branches:
#   PROD: Vercel "Production", branch main, www.pitchnest.app.
#         VITE_API_URL unset, VITE_WS_BACKEND_URL=wss://pitchnest-live.onrender.com/ws,
#         VITE_GOOGLE_CLIENT_ID = the PROD Google client.
#   DEV:  Vercel "Preview", branch dev.
#         VITE_API_URL=https://l5isutzx18.execute-api.eu-west-2.amazonaws.com
#         VITE_WS_BACKEND_URL=wss://pitchnest-backend-dev.onrender.com/ws
#         VITE_GOOGLE_CLIENT_ID = the DEV Google client (its own Google Cloud project).
#   A Preview build without the DEV values would call PROD, so keep them set for Preview.

# API origin. Leave unset in production: vercel.json forwards /api to the API
# on AWS, so the browser calls the API on its own origin. Set it only to call
# an API on another origin (see src/lib/apiBase.ts and src/main.tsx).
VITE_API_URL=

# WebSocket URL for the live pitch room, which runs on Render.
# Defaults to wss://pitchnest-live.onrender.com/ws; a bare origin gets /ws added.
VITE_WS_BACKEND_URL=wss://pitchnest-live.onrender.com/ws

# Google OAuth Client ID (Optional, from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
